# Copy to .env and fill in. Never commit .env.

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma separated chat ids allowed to use the bot. Leave empty the first time:
# the bot will reply with your chat_id so you can paste it here.
ALLOWED_CHAT_IDS=

# mock = synthetic local data (free) | databricks = real tables (starts the SQL Warehouse, billed)
DATA_SOURCE=mock

# --- only for DATA_SOURCE=databricks ---
DATABRICKS_CATALOG=soccer
DATABRICKS_HOST=https://dbc-06090e42-ea4e.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/eb4dcd7819b7e732
# Use either a CLI profile (OAuth login) or a token
DATABRICKS_CONFIG_PROFILE=soccer
DATABRICKS_TOKEN=
# Seconds to cache query results (fewer warehouse wake-ups = lower cost)
CACHE_TTL_SECONDS=3600

# --- access ---
# allowlist = only ALLOWED_CHAT_IDS (+ admins) | public = anyone
ACCESS_MODE=allowlist
# Admins: no question quota, can use /uso and /sugerencias
ADMIN_CHAT_IDS=

# --- natural language (Claude API, billed per question) ---
# Needs ANTHROPIC_API_KEY (console.anthropic.com). Off by default.
NL_ENABLED=false
ANTHROPIC_API_KEY=
# Longer messages are rejected before calling the model
NL_MAX_CHARS=300

# --- plans & billing ---
# Prices, quotas and features live in plans.json (override the path with PLANS_PATH)
# Local SQLite with users, subscriptions, packs and question log
DB_PATH=bot.sqlite3
# Shown to the user after picking a plan in /planes (use \n for new lines)
PAYMENT_INSTRUCTIONS=Un administrador te escribirá para completar el pago.
