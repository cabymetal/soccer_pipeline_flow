# Copy to .env and fill in. Never commit .env.

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma separated chat ids allowed to use the bot. Leave empty the first time:
# the bot will reply with your chat_id so you can paste it here.
ALLOWED_CHAT_IDS=

# mock = synthetic local data (free) | databricks = real tables (starts the SQL Warehouse, billed)
DATA_SOURCE=mock

# --- only for DATA_SOURCE=databricks ---
DATABRICKS_CATALOG=soccer
DATABRICKS_HOST=https://dbc-06090e42-ea4e.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/eb4dcd7819b7e732
# Use either a CLI profile (OAuth login) or a token
DATABRICKS_CONFIG_PROFILE=soccer
DATABRICKS_TOKEN=
# Seconds to cache query results (fewer warehouse wake-ups = lower cost)
CACHE_TTL_SECONDS=3600
